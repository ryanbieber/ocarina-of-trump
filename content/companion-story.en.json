  "messages": [
    {"id":"0x00CF","context":"Unusable item warning","pages":[["Good item. Wrong place.","Try it somewhere useful."]]},
    {"id":"0x00D0","context":"Locked interaction","pages":[["It won't open. Tough negotiator."]]},
    {"id":"0x0228","context":"Point of interest","pages":[["Look at this. Worth a closer look."]]},
    {"id":"0x023B","context":"Unidentified reaction","pages":[["Well. That needs explaining."]]},
    {"id":"0x1000","context":"Trump introduces himself","pages":[["You're awake. Finally.","I'm Trump, your fairy partner."],["The Great Deku Tree sent me.","He wanted someone with presence.","Apparently, wings were enough."]]},
    {"id":"0x102B","context":"Leave for Hyrule Castle","pages":[["Hyrule Castle next, {player}.","Let's meet the management."]]},
    {"id":"0x102C","context":"Farewell to Deku Tree","pages":[["Good-bye, Great Deku Tree.","We'll finish what you started."]]},
    {"id":"0x107D","context":"Return to Deku Tree","pages":[["Great Deku Tree, I'm back.","And I brought the boy."]]},
    {"id":"0x1095","context":"Wake Link greeting","pages":[["{player}, wake up.","The forest has a situation."],["The Great Deku Tree needs you.","Come on. Destiny keeps terrible", "hours."]]},
    {"id":"0x1096","context":"Wake Link follow-up","pages":[["Up. Come on. We have a quest."],["Hyrule's future is in this bed.","I'd feel better if it sat up."]]},
    {"id":"0x1098","context":"Urgent Deku Tree summons","pages":[["The Great Deku Tree called.","An actual tree. Very important.","Let's get moving."]]},
    {"id":"0x1099","context":"Deku Tree calls for Trump","speaker":"Deku Tree","pages":[["Trump...", "Trump, where art thou?", "Come hither..."]]},
    {"id":"0x10B1","context":"Sleeping person","pages":[["No response. He's sleeping.","A very firm negotiating position."]]},
    {"id":"0x3040","context":"Heat hazard","pages":[["Too hot. We can't stay long.","Get out before the heat gets us."]]},
    {"id":"0x305F","context":"Shield stolen","pages":[["Your shield is gone!", "That's a serious equipment issue."]]},
    {"id":"0x3060","context":"Tunic stolen","pages":[["Your tunic is gone!", "That was not part of the deal."]]},
    {"id":"0x3061","context":"Shield and tunic stolen","pages":[["Your shield AND tunic are gone!", "We have to recover your gear."]]},
    {"id":"0x3066","context":"Egg hatches","pages":[["The egg hatched! A chicken.","Our smallest project delivered."]]},
    {"id":"0x401D","context":"Underwater danger","pages":[["You can't breathe down here!", "Take off those boots and get air."]]},
    {"id":"0x5071","context":"Sinking Shadow Temple boat","pages":[["The ship is sinking!", "No more inspections. Jump to", "a safe platform now!"]]},
    {"id":"0x7050","context":"Adult Link reveal","pages":[["{player}, you're taller!", "Finally, some visible progress."]]},
    {"id":"0x7054","context":"Seven years later","pages":[["The Temple of Time again...", "Seven years? That meeting ran", "longer than expected."],["Some weapons from your childhood", "won't work for you now.", "Check your equipment."],["Let's get outside and see", "what happened to Hyrule."]]},
    {"id":"0x70CD","context":"Ganondorf repels Trump","pages":[["{player}, I can't get close!", "Those waves of darkness keep", "pushing me back."],["I'm sorry. You'll have to handle", "this part without my advice."]]},
    {"id":"0x70D4","context":"After Ganondorf fight","pages":[["I'm sorry I couldn't help.", "That barrier was stronger", "than my objections."]]},
    {"id":"0x70D6","context":"Trump returns for Ganon","pages":[["He's not keeping me out again.", "This time we fight together."]]},
    {"id":"0x70E6","context":"Spot the legendary sword","pages":[["{player}, look at that!"]]},
    {"id":"0x70E7","context":"Recognize legendary blade","pages":[["That blade has a reputation."]]},
    {"id":"0x70E8","context":"Master Sword reveal","pages":[["The Master Sword!", "Now that's proper equipment."]]},
    {"id":"0x71B0","context":"Timed delivery spoiled","pages":[["Time's up! The delivery spoiled.", "We'll need a fresh one.", "Next time, fewer detours."]]}
  ]
